<%= render Admin::SearchComponent.new(label: label, class: "sua-relations-search complex") do |component| %>
  <%= component.select_tag :goal_code, sua_goal_options,
                           include_blank: goal_blank_option,
                           "aria-label": goal_label %>
  <%= component.select_tag :target_code, sua_target_options,
                           include_blank: target_blank_option,
                           "aria-label": target_label %>
  <%= component.hidden_field_tag :filter, current_filter %>
<% end %>
