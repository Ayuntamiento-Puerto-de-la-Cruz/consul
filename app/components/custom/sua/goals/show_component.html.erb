<% provide(:title) { goal.title } %>

<div class="sua-goal-show">
  <%= back_link_to sua_goals_path %>

  <article class="sua-goal sua-goal-<%= code %>">
    <header>
      <h1><%= heading %></h1>
    </header>
  </article>

  <%= render ::Widget::Feeds::ParticipationComponent.new(feeds) %>

  <% if processes_feed %>
    <div class="feeds-list">
      <%= render ::Widget::Feeds::FeedComponent.new(processes_feed) %>
    </div>
  <% end %>

  <%= render SUA::Goals::TargetsComponent.new(goal) %>
</div>
